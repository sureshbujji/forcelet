     "target_minutes": 30
    },
    {
     "name": "Resolution",
     "target_minutes": 240
    }
   ],
   "name": "Standard case SLA - Critical",
   "object": "Case",
   "priority": "Critical"
  },
  {
   "active": true,
   "milestones": [
    {
     "name": "First response",
     "target_minutes": 60
    },
    {
     "name": "Resolution",
     "target_minutes": 480
    }
   ],
   "name": "Standard case SLA - High",
   "object": "Case",
   "priority": "High"
  },
  {
   "active": true,
   "milestones": [
    {
     "name": "First response",
     "target_minutes": 240
    },
    {
     "name": "Resolution",
     "target_minutes": 1440
    }
   ],
   "name": "Standard case SLA - Medium",
   "object": "Case",
   "priority": "Medium"
  },
  {
   "active": true,
   "milestones": [
    {
     "name": "First response",
     "target_minutes": 480
    },
    {
