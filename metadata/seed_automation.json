   "object": "Case",
   "active": true,
   "priority": "Critical",
   "milestones": [
    {
     "name": "First response",
     "target_minutes": 30
    },
    {
     "name": "Resolution",
     "target_minutes": 240
    }
   ]
  },
  {
   "name": "Standard case SLA - High",
   "object": "Case",
   "active": true,
   "priority": "High",
   "milestones": [
    {
     "name": "First response",
     "target_minutes": 60
    },
    {
     "name": "Resolution",
     "target_minutes": 480
    }
   ]
  },
  {
   "name": "Standard case SLA - Medium",
   "object": "Case",
   "active": true,
   "priority": "Medium",
   "milestones": [
    {
     "name": "First response",
     "target_minutes": 240
    },
    {
     "name": "Resolution",
     "target_minutes": 1440
    }
   ]
  },
  {
   "name": "Standard case SLA - Low",
   "object": "Case",
   "active": true,
   "priority": "Low",
