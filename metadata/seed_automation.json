{
 "approval_processes": [
  {
   "active": true,
   "entry_conditions": {
    "<": [
     20,
     {
      "field": "DiscountPercent"
     }
    ]
   },
   "name": "Large Discount Approval",
   "object": "Opportunity",
   "steps": [
    {
     "approver": "manager",
     "name": "Sales Manager approval"
    }
   ]
  }
 ],
 "assignment_rules": [
  {
   "active": true,
   "assignee": {
    "type": "round_robin",
    "usernames": [
     "leo",
     "maya"
    ]
   },
   "criteria": {
    "==": [
     {
      "field": "LeadSource"
     },
     "Web"
    ]
   },
   "name": "Round-robin web leads",
   "object": "Lead",
   "order": 10
  }
 ],
 "auto_responses": [],
 "email_templates": [
  {
   "body": "Hi {{Record.FirstName}},\n\nThanks for your interest in {{Record.Company}}.\nI'll be in touch shortly.\n\nBest,\n{{User.Name}}",
   "name": "New lead welcome",
   "subject": "Welcome, {{Record.FirstName}}!"
  },
  {
   "body": "Hi {{Record.FirstName}},\n\nThanks for contacting support. We've opened case '{{Record.Subject}}' and will respond shortly.\n\nBest,\n{{User.Name}}",
   "name": "New case acknowledgment",
   "subject": "We received your case: {{Record.Subject}}"
  }
 ],
 "escalation_rules": [
  {
   "action": {
    "fields": {
     "Priority": "Critical"
    },
    "type": "set_fields"
   },
   "active": true,
   "criteria": {
    "contains": [
     {
      "field": "Subject"
     },
     "urgent"
    ]
   },
   "name": "VIP escalation",
   "object": "Case",
   "trigger_on": "save"
  },
  {
   "action": {
    "fields": {
     "Status": "Escalated"
    },
    "type": "set_fields"
   },
   "active": true,
   "criteria": {},
   "name": "Escalate SLA-breached cases",
   "object": "Case",
   "trigger_on": "sla_breach"
  }
 ],
 "flows": [
  {
   "actions": [
    {
     "fields": {
      "AccountId": "{{Trigger.AccountId}}",
      "Priority": "High",
      "Status": "Not Started",
      "Subject": "Follow up: {{Trigger.Name}}"
     },
     "object": "Task",
     "type": "create_record"
    }
   ],
   "active": true,
   "condition": {
    "and": [
     {
      "==": [
       {
        "field": "Stage"
       },
       "Negotiation"
      ]
     },
     {
      "!=": [
       {
        "field_old": "Stage"
       },
       "Negotiation"
      ]
     }
    ]
   },
   "name": "Negotiation follow-up task",
   "object": "Opportunity",
   "trigger": "on_update"
  },
  {
   "active": true,
   "finish_actions": [
    {
     "fields": {
      "Email": "{{Trigger.Email}}",
      "FirstName": "{{Trigger.FirstName}}",
      "LastName": "{{Trigger.LastName}}",
      "Phone": "{{Trigger.Phone}}",
      "Title": "{{Trigger.Title}}"
     },
     "object": "Contact",
     "type": "create_record"
    }
   ],
   "flow_type": "screen",
   "name": "Quick contact create",
   "screens": [
    {
     "fields": [
      {
       "label": "First name",
       "name": "FirstName",
       "type": "text"
      },
      {
       "label": "Last name",
       "name": "LastName",
       "required": true,
       "type": "text"
      },
      {
       "label": "Email",
       "name": "Email",
       "type": "email"
      },
      {
       "label": "Phone",
       "name": "Phone",
       "type": "phone"
      }
     ],
     "id": "s1",
     "title": "New contact"
    },
    {
     "fields": [
      {
       "label": "Title",
       "name": "Title",
       "type": "text"
      }
     ],
     "id": "s2",
     "title": "Role"
    }
   ]
  },
  {
   "actions": [
    {
     "fields": {
      "AccountId": "{{Trigger.AccountId}}",
      "Name": "Delivery for {{Trigger.OrderNumber}}",
      "OrderId": "{{Trigger.Id}}",
      "ScheduledDate": "{{Trigger.OrderDate}}",
      "Status": "Scheduled"
     },
     "object": "Delivery",
     "type": "create_record"
    }
   ],
   "active": true,
   "condition": {
    "and": [
     {
      "==": [
       {
        "field": "Status"
       },
       "Activated"
      ]
     },
     {
      "!=": [
       {
        "field_old": "Status"
       },
       "Activated"
      ]
     }
    ]
   },
   "name": "Auto-create delivery on order activation",
   "object": "Order",
   "trigger": "on_update"
  },
  {
   "actions": [
    {
     "fields": {
      "Status": "Delivered"
     },
     "object": "Vehicle",
     "record_id": "{{Trigger.VehicleId}}",
     "type": "set_fields"
    }
   ],
   "active": true,
   "condition": {
    "and": [
     {
      "==": [
       {
        "field": "Status"
       },
       "Delivered"
      ]
     },
     {
      "!=": [
       {
        "field_old": "Status"
       },
       "Delivered"
      ]
     },
     {
      "not": {
       "isblank": {
        "field": "VehicleId"
       }
      }
     }
    ]
   },
   "name": "Mark vehicle delivered",
   "object": "Delivery",
   "trigger": "on_update"
  },
  {
   "actions": [
    {
     "fields": {
      "Status": "Completed"
     },
     "object": "WorkOrder",
     "record_id": "{{Trigger.WorkOrderId}}",
     "type": "set_fields"
    }
   ],
   "active": true,
   "condition": {
    "and": [
     {
      "==": [
       {
        "field": "Status"
       },
       "Completed"
      ]
     },
     {
      "!=": [
       {
        "field_old": "Status"
       },
       "Completed"
      ]
     }
    ]
   },
   "name": "Complete work order when appointment done",
   "object": "ServiceAppointment",
   "trigger": "on_update"
  }
 ],
 "list_views": [
  {
   "columns": [
    "Name",
    "Industry",
    "Phone",
    "TotalPipeline"
   ],
   "filters": {},
   "name": "All Accounts",
   "object": "Account",
   "shared": true,
   "sort_by": "Name",
   "sort_dir": "asc"
  },
  {
   "columns": [
    "Name",
    "Amount",
    "Stage",
    "CloseDate"
   ],
   "filters": {
    "and": [
     {
      "==": [
       {
        "field": "OwnerId"
       },
       {
        "user_id": true
       }
      ]
     },
     {
      "not": {
       "in": [
        {
         "field": "Stage"
        },
        [
         "Closed Won",
         "Closed Lost"
        ]
       ]
      }
     }
    ]
   },
   "name": "My Open Pipeline",
   "object": "Opportunity",
   "shared": true,
   "sort_by": "Amount",
   "sort_dir": "desc"
  },
  {
   "columns": [
    "LastName",
    "Company",
    "Status",
    "Rating"
   ],
   "filters": {
    "==": [
     {
      "field": "Status"
     },
     "New"
    ]
   },
   "name": "New Leads",
   "object": "Lead",
   "shared": true,
   "sort_by": "CreatedDate",
   "sort_dir": "desc"
  }
 ],
 "matching_rules": [
  {
   "active": true,
   "fields": [
    "Email"
   ],
   "name": "Lead email duplicates",
   "object": "Lead"
  },
  {
   "active": true,
   "fields": [
    "VIN"
   ],
   "name": "Duplicate VIN detection",
   "object": "Vehicle"
  }
 ],
 "paths": [
  {
   "active": true,
   "field": "Stage",
   "guidance": {
    "Closed Lost": "Log the loss reason so we learn from it.",
    "Closed Won": "Hand off to delivery. Celebrate!",
    "Negotiation": "Handle objections; keep discount approvals tight.",
    "Proposal": "Send the proposal and agree on decision criteria and date.",
    "Prospecting": "Identify the prospect's needs and confirm fit before investing more time.",
    "Qualification": "Confirm budget, authority, need, and timeline (BANT)."
   },
   "name": "Opportunity sales path",
   "object": "Opportunity"
  },
  {
   "active": true,
   "field": "Status",
   "guidance": {
    "Delivered": "Handed over to the customer. Celebrate!",
    "In Service": "Vehicle is in for service; check open work orders.",
    "In Stock": "Vehicle is in inventory and available for sale.",
    "Reserved": "Reserved for a buyer; do not promise to others.",
    "Sold": "Sold; create the asset record and schedule delivery."
   },
   "name": "Vehicle lifecycle",
   "object": "Vehicle"
  },
  {
   "active": true,
   "field": "Status",
   "guidance": {
    "Activated": "Order is live; delivery auto-creates on activation.",
    "Cancelled": "Log the cancellation reason.",
    "Draft": "Build the order with products and vehicles.",
    "Fulfilled": "All items delivered; close out the order.",
    "Submitted": "Awaiting approval before activation."
   },
   "name": "Order fulfillment",
   "object": "Order"
  },
  {
   "active": true,
   "field": "Status",
   "guidance": {
    "Cancelled": "Log the cancellation reason.",
    "Completed": "Verify the fix with the customer and close out.",
    "In Progress": "Technician is on it; track parts and labor.",
    "New": "Triage the request and schedule an appointment.",
    "On Hold": "Waiting on parts or customer; set a follow-up date."
   },
   "name": "Work order service path",
   "object": "WorkOrder"
  }
 ],
 "permission_set_assignments": {
  "maya": [
   "DeleteLeads"
  ]
 },
 "permission_sets": [
  {
   "field_permissions": {},
   "label": "Delete Leads",
   "name": "DeleteLeads",
   "object_permissions": {
    "Lead": {
     "create": false,
     "delete": true,
     "edit": false,
     "read": false
    }
   }
  }
 ],
 "record_types": [
  {
   "is_default": true,
   "label": "SMB",
   "name": "SMB",
   "object": "Opportunity"
  },
  {
   "label": "Enterprise",
   "name": "Enterprise",
   "object": "Opportunity",
   "picklist_overrides": {
    "Stage": [
     "Prospecting",
     "Qualification",
     "Security Review",
     "Proposal",
     "Negotiation",
     "Closed Won",
     "Closed Lost"
    ]
   }
  }
 ],
 "reports": [
  {
   "active": true,
   "aggregate": {
    "field": "Amount",
    "func": "sum"
   },
   "chart": "bar",
   "columns": [
    "Name",
    "Amount",
    "Stage",
    "CloseDate"
   ],
   "filters": {},
   "group_by": "Stage",
   "name": "Pipeline by Stage",
   "object": "Opportunity"
  }
 ],
 "scheduled_jobs": [
  {
   "active": true,
   "code": "soon = (today() + timedelta(days=7)).isoformat()\nfor o in query('Opportunity'):\n    cd = o.get('CloseDate') or ''\n    if o.get('Stage') in ('Closed Won', 'Closed Lost') or not cd or cd > soon:\n        continue\n    create('Task', {'Subject': f\"Closing soon: {o.get('Name')} ({cd})\",\n                    'Status': 'Not Started', 'Priority': 'High',\n                    'OwnerId': o.get('owner_id')})\n",
   "interval_minutes": 1440,
   "name": "Close-date reminders",
   "run_as": "admin"
  },
  {
   "active": true,
   "code": "breached = automation.check_sla_breaches(store, security)\nfor m in breached:\n    rec = store.get(m.get('object') or 'Case', m['record_id'])\n    if rec:\n        automation.apply_escalation_rules(store, registry, security,\n            m.get('object') or 'Case', rec, None, user,\n            trigger_on='sla_breach')\n",
   "interval_minutes": 60,
   "name": "Case SLA monitor",
   "run_as": "admin"
  }
 ],
 "sharing_rules": [
  {
   "active": true,
   "criteria": {
    "==": [
     {
      "field": "Priority"
     },
     "Critical"
    ]
   },
   "name": "Critical cases to support",
   "object": "Case",
   "share_with": {
    "role": "Support Agent",
    "type": "role"
   }
  }
 ],
 "sla_policies": [
