 ],
 "triggers": [
  {
   "active": true,
   "code": "PROB = {'Prospecting': 10, 'Qualification': 25, 'Security Review': 35,\n        'Proposal': 50, 'Negotiation': 75, 'Closed Won': 100, 'Closed Lost': 0}\nstage = record.get('Stage')\nif stage in PROB:\n    record['Probability'] = PROB[stage]\n",
   "events": [
    "before_insert",
    "before_update"
   ],
   "name": "Set Probability from Stage",
   "object": "Opportunity",
   "order": 10
  },
  {
   "active": true,
   "code": "open_opps = [o for o in query('Opportunity', AccountId=record.get('id'))\n             if o.get('Stage') not in ('Closed Won', 'Closed Lost')]\nif open_opps:\n    errors.append(f\"Cannot delete: {len(open_opps)} open opportunity(s) exist\")\n",
   "events": [
    "before_delete"
   ],
   "name": "Block Account delete with open Opps",
   "object": "Account",
   "order": 10
  },
  {
   "active": true,
   "code": "create('Task', {'Subject': f\"Welcome {record.get('FirstName') or ''} {record.get('LastName')}\".strip(),\n                'Status': 'Not Started', 'Priority': 'Normal'})\n",
   "events": [
    "after_insert"
   ],
   "name": "Welcome task for new Contact",
   "object": "Contact",
   "order": 20
  },
  {
   "active": true,
   "code": "qty = record.get('Quantity') or 0\nprice = record.get('UnitPrice') or 0\ndisc = record.get('Discount') or 0\ntry:\n    total = float(qty) * float(price) * (1 - float(disc) / 100)\nexcept (TypeError, ValueError):\n    total = 0\nrecord['TotalPrice'] = round(total, 2)\n",
   "events": [
    "before_insert",
    "before_update"
   ],
   "name": "Compute quote line total",
   "object": "QuoteLineItem",
   "order": 10
  },
  {
   "active": true,
   "code": "if not record.get('OrderNumber'):\n    n = len(query('Order')) + 1\n    record['OrderNumber'] = 'ORD-%06d' % n\n",
   "events": [
    "before_insert"
   ],
   "name": "Generate OrderNumber",
   "object": "Order",
   "order": 10
  },
  {
   "active": true,
   "code": "if not record.get('DeliveryNumber'):\n    n = len(query('Delivery')) + 1\n    record['DeliveryNumber'] = 'DLV-%06d' % n\n",
   "events": [
    "before_insert"
   ],
   "name": "Generate DeliveryNumber",
   "object": "Delivery",
   "order": 10
  },
  {
   "active": true,
   "code": "qty = record.get('Quantity') or 0\nprice = record.get('UnitPrice') or 0\ntry:\n    total = float(qty) * float(price)\nexcept (TypeError, ValueError):\n    total = 0\nrecord['LineTotal'] = round(total, 2)\n",
   "events": [
    "before_insert",
    "before_update"
   ],
   "name": "Compute order line total",
   "object": "OrderItem",
   "order": 10
  },
  {
   "active": true,
   "code": "if not record.get('WorkOrderNumber'):\n    n = len(query('WorkOrder')) + 1\n    record['WorkOrderNumber'] = 'W-%06d' % n\n",
   "events": [
    "before_insert"
   ],
   "name": "Generate WorkOrderNumber",
   "object": "WorkOrder",
   "order": 10
  },
  {
   "active": true,
   "code": "if not record.get('ContractNumber'):\n    n = len(query('Contract')) + 1\n    record['ContractNumber'] = 'C-%06d' % n\n",
   "events": [
    "before_insert"
   ],
   "name": "Generate ContractNumber",
   "object": "Contract",
   "order": 10
  },
  {
   "active": true,
   "code": "if not record.get('ArticleNumber'):\n    n = len(query('KnowledgeArticle')) + 1\n    record['ArticleNumber'] = 'KA-%06d' % n\n",
   "events": [
    "before_insert"
   ],
   "name": "Generate ArticleNumber",
   "object": "KnowledgeArticle",
   "order": 10
  }
 ],
 "validation_rules": [
  {
   "active": true,
   "condition": {
    "and": [
     {
      "not": {
       "in": [
        {
         "field": "Stage"
        },
        [
         "Closed Won",
         "Closed Lost"
        ]
       ]
      }
     },
     {
      "<": [
       {
        "field": "CloseDate"
       },
       {
        "today": true
       }
      ]
     }
    ]
   },
   "message": "Close Date cannot be in the past for an open opportunity.",
   "name": "CloseDate not in past",
   "object": "Opportunity"
  },
  {
   "active": true,
   "condition": {
    "and": [
     {
      "not": {
       "isblank": {
        "field": "VIN"
       }
      }
     },
     {
      "!=": [
       {
        "len": {
         "field": "VIN"
        }
       },
       17
      ]
     }
    ]
   },
   "message": "VIN must be exactly 17 characters.",
   "name": "VIN must be 17 characters",
   "object": "Vehicle"
  },
  {
   "active": true,
   "condition": {
    "and": [
     {
      "not": {
       "isblank": {
        "field": "DeliveredDate"
       }
      }
     },
     {
      "not": {
       "isblank": {
        "field": "ScheduledDate"
       }
      }
     },
     {
      "<": [
       {
        "field": "DeliveredDate"
       },
       {
        "field": "ScheduledDate"
       }
      ]
     }
    ]
   },
   "message": "Delivered Date cannot be before the Scheduled Date.",
   "name": "Delivered date not before scheduled date",
   "object": "Delivery"
  },
  {
   "active": true,
   "condition": {
    "and": [
     {
      "not": {
       "isblank": {
        "field": "StartDate"
       }
      }
     },
     {
      "not": {
       "isblank": {
        "field": "EndDate"
       }
      }
     },
     {
      "<=": [
       {
        "field": "EndDate"
       },
       {
        "field": "StartDate"
       }
      ]
     }
    ]
   },
   "message": "Contract End Date must be after the Start Date.",
   "name": "Contract end after start",
   "object": "Contract"
  },
  {
   "active": true,
   "condition": {
    "and": [
     {
      "not": {
       "isblank": {
        "field": "StartDateTime"
       }
      }
     },
     {
      "not": {
       "isblank": {
        "field": "EndDateTime"
       }
      }
     },
     {
      "<": [
       {
        "field": "EndDateTime"
       },
       {
        "field": "StartDateTime"
       }
      ]
     }
    ]
   },
   "message": "Event End must not be before Start.",
   "name": "Event end not before start",
   "object": "Event"
  }
 ]
}
