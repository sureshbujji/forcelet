    {
     "name": "First response",
     "target_minutes": 480
    },
    {
     "name": "Resolution",
     "target_minutes": 2880
    }
   ]
  }
 ],
 "escalation_rules": [
  {
   "name": "VIP escalation",
   "object": "Case",
   "active": true,
   "trigger_on": "save",
   "criteria": {
    "contains": [
     {
      "field": "Subject"
     },
     "urgent"
    ]
   },
   "action": {
    "type": "set_fields",
    "fields": {
     "Priority": "Critical"
    }
   }
  },
  {
   "name": "Escalate SLA-breached cases",
   "object": "Case",
   "active": true,
   "trigger_on": "sla_breach",
   "criteria": {},
   "action": {
    "type": "set_fields",
    "fields": {
     "Status": "Escalated"
    }
   }
  }
 ]
}